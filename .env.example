# Session name for LocalAuth profile
SESSION_NAME=default

# Persisted auth directory inside container
WWEBJS_AUTH_PATH=.wwebjs_auth

# Chromium binary path in Docker image
CHROME_PATH=/usr/bin/chromium

# Run browser in headless mode
HEADLESS=true

# Comma-separated list of country codes to block.
# Use numbers only, without + sign, e.g. 1,44,91
BLOCKED_COUNTRY_CODES=47,593

# Port for this service
PORT=8787
